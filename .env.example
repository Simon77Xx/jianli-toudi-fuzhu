# 支持 openai 或 anthropic。页面不会展示或保存这些值。
LLM_PROTOCOL=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 留空时自动寻找 MiKTeX 的 xelatex；也可填写完整路径。
XELATEX_PATH=
# 如需允许 MiKTeX 在编译时自动联网装包，可设为 1（默认 0 以防卡死超时）。
MIKTEX_AUTO_INSTALL=0
MAX_INPUT_CHARS=180000
LLM_TIMEOUT=120
# 可选：开启 GitHub 证据时提升公开 API 速率限制。
GITHUB_TOKEN=

